        \} else \{\
          tasksData = INITIAL_TASKS;\
          saveTasksLocally();\
        \}\
        refreshUI();\
      \}\
    \});\
\
    function saveTasksData() \{\
      if (isFirebaseConnected && dbRef) \{\
        dbRef.set(tasksData);\
      \} else \{\
        saveTasksLocally();\
        refreshUI();\
      \}\
    \}\
\
    function saveTasksLocally() \{\
      localStorage.setItem("gantt_tasks_local", JSON.stringify(tasksData));\
    \}\
\
    function refreshUI() \{\
      renderGantt();\
      updateDashboard();\
    \}\
\
    /* -------------------------------------------------------------\
     * 4. \uc0\u12460 \u12531 \u12488 \u12481 \u12515 \u12540 \u12488 \u25551 \u30011 \u12525 \u12472 \u12483 \u12463 \
     * ------------------------------------------------------------- */\
    function renderGantt() \{\
      const searchKeyword = document.getElementById("search-input").value.toLowerCase();\
      const table = document.getElementById("gantt-table");\
      table.innerHTML = "";\
\
      // \uc0\u26085 \u20184 \u12522 \u12473 \u12488 \u12398 \u29983 \u25104  (2026-09-01 \u12316  2027-03-31)\
      const dateList = generateDateArray(CONFIG.startDate, CONFIG.endDate);\
\
      // --- \uc0\u12486 \u12540 \u12502 \u12523 \u12504 \u12483 \u12480 \u12540 \u27083 \u31689  ---\
      let thead = `<thead class="sticky-header">\
        <tr class="bg-slate-200 text-slate-700 font-bold border-b border-slate-300">\
          <th class="p-2 border-r border-slate-300 sticky-col min-w-[200px]">ID / \uc0\u12479 \u12473 \u12463 \u21517 </th>\
          <th class="p-2 border-r border-slate-300 w-20 text-center">\uc0\u25285 \u24403 </th>\
          <th class="p-2 border-r border-slate-300 w-20 text-center">\uc0\u29366 \u24907 </th>\
          <th class="p-2 border-r border-slate-300 w-16 text-center">\uc0\u25805 \u20316 </th>`;\
      \
      dateList.forEach(d => \{\
        const isTarget = d === CONFIG.targetDate;\
        const bg = isTarget ? "bg-amber-300 text-slate-900" : "bg-slate-100 text-slate-600";\
        thead += `<th class="px-1 py-1 text-[10px] text-center border-r border-slate-200 min-w-[24px] $\{bg\}">$\{d.slice(5)\}</th>`;\
      \});\
      thead += `</tr></thead>`;\
\
      // --- \uc0\u12486 \u12540 \u12502 \u12523 \u12508 \u12487 \u12451 \u27083 \u31689  ---\
      let tbody = `<tbody>`;\
\
      // \uc0\u12459 \u12486 \u12468 \u12522 \u12540 \u12372 \u12392 \u12395 \u12464 \u12523 \u12540 \u12503 \u21270 \
      for (let catKey = 1; catKey <= 5; catKey++) \{\
        const catTasks = tasksData.filter(t => t.cat == catKey && (\
          t.name.toLowerCase().includes(searchKeyword) || \
          t.assignee.toLowerCase().includes(searchKeyword) ||\
          t.id.includes(searchKeyword)\
        ));\
\
        // \uc0\u12459 \u12486 \u12468 \u12522 \u12540 \u12504 \u12483 \u12480 \u12540 \u34892 \
        tbody += `<tr class="bg-slate-800 text-white font-bold">\
          <td colspan="$\{4 + dateList.length\}" class="p-2 text-xs sticky-col">\
            $\{CATEGORIES[catKey]\}\
          </td>\
        </tr>`;\
\
        if (catTasks.length === 0) \{\
          tbody += `<tr><td colspan="$\{4 + dateList.length\}" class="p-2 text-slate-400 italic text-center">\uc0\u35442 \u24403 \u12377 \u12427 \u12479 \u12473 \u12463 \u12399 \u12354 \u12426 \u12414 \u12379 \u12435 </td></tr>`;\
        \} else \{\
          catTasks.forEach(task => \{\
            const isDelayed = checkIsDelayed(task);\
            const statusColor = getStatusColorClass(task.status);\
\
            tbody += `<tr id="task-row-$\{task.idKey\}" class="hover:bg-slate-50 border-b border-slate-200 transition">\
              <!-- \uc0\u12479 \u12473 \u12463 \u22522 \u26412 \u24773 \u22577  (\u22266 \u23450 \u21015 ) -->\
              <td class="p-2 border-r border-slate-200 sticky-col font-medium flex items-center gap-1.5">\
                $\{task.cp ? '<i class="fa-solid fa-star text-red-500" title="\uc0\u12463 \u12522 \u12486 \u12451 \u12459 \u12523 \u12497 \u12473 "></i>' : ''\}\
                <span class="text-slate-500 text-[11px] font-mono">$\{task.id\}</span>\
                <span class="$\{isDelayed ? 'text-red-600 font-bold' : 'text-slate-800'\}">$\{escapeHTML(task.name)\}</span>\
              </td>\
              <td class="p-1 border-r border-slate-200 text-center text-[11px]">$\{escapeHTML(task.assignee)\}</td>\
              <td class="p-1 border-r border-slate-200 text-center">\
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold text-white $\{statusColor\}">$\{task.status\}</span>\
              </td>\
              <td class="p-1 border-r border-slate-200 text-center">\
                <button onclick="openEditTaskModal('$\{task.idKey\}')" class="text-blue-600 hover:text-blue-800 mr-1"><i class="fa-solid fa-pen-to-square"></i></button>\
                <button onclick="deleteTask('$\{task.idKey\}')" class="text-red-500 hover:text-red-700"><i class="fa-solid fa-trash"></i></button>\
              </td>`;\
\
            // \uc0\u12460 \u12531 \u12488 \u12481 \u12515 \u12540 \u12488 \u12496 \u12540 \u12475 \u12523 \u25551 \u30011 \
            dateList.forEach(d => \{\
              const inRange = d >= task.start && d <= task.end;\
              let cellBg = "";\
              if (inRange) \{\
                if (task.status === "\uc0\u23436 \u20102 ") cellBg = "bg-emerald-500";\
                else if (task.status === "\uc0\u20445 \u30041 \u20013 ") cellBg = "bg-amber-400";\
                else if (isDelayed) cellBg = "bg-red-500 animate-pulse";\
                else cellBg = "bg-blue-500";\
              \}\
              const isTargetDay = d === CONFIG.targetDate;\
              const borderStyle = isTargetDay ? "border-x-2 border-x-amber-400" : "border-r border-slate-100";\
\
              tbody += `<td class="p-0 text-center $\{borderStyle\} $\{cellBg\}" title="$\{task.name\} ($\{task.start\} \uc0\u12316  $\{task.end\})"></td>`;\
            \});\
\
            tbody += `</tr>`;\
          \});\
        \}\
      \}\
\
      tbody += `</tbody>`;\
      table.innerHTML = thead + tbody;\
    \}\
\
    /* -------------------------------------------------------------\
     * 5. \uc0\u33258 \u21205 \u38598 \u35336 \u12480 \u12483 \u12471 \u12517 \u12508 \u12540 \u12489  \u12525 \u12472 \u12483 \u12463 \
     * ------------------------------------------------------------- */\
    let companyChartInstance = null;\
\
    function updateDashboard() \{\
      if (tasksData.length === 0) return;\
\
      // 1. \uc0\u20840 \u20307 \u36914 \u25431 \u29575 \u12398 \u35336 \u31639 \
      const completedCount = tasksData.filter(t => t.status === "\uc0\u23436 \u20102 ").length;\
      const overallProgress = Math.round((completedCount / tasksData.length) * 100);\
      document.getElementById("kpi-progress").innerText = `$\{overallProgress\}%`;\
\
      // 2. \uc0\u12463 \u12522 \u12486 \u12451 \u12459 \u12523 \u12497 \u12473 (CP)\u36914 \u34892 \u29366 \u27841 \
      const cpTasks = tasksData.filter(t => t.cp);\
      const cpCompleted = cpTasks.filter(t => t.status === "\uc0\u23436 \u20102 ").length;\
      document.getElementById("kpi-cp-status").innerText = `$\{cpCompleted\} / $\{cpTasks.length\}`;\
\
      // 3. \uc0\u36933 \u24310 \u12479 \u12473 \u12463 \u26908 \u20986 \u65286 \u12522 \u12473 \u12488 \u34920 \u31034 \
      const delayedTasks = tasksData.filter(t => checkIsDelayed(t));\
      const delayedContainer = document.getElementById("delayed-tasks-list");\
      if (delayedTasks.length === 0) \{\
        delayedContainer.innerHTML = `<p class="text-slate-400 italic">\uc0\u36933 \u24310 \u12479 \u12473 \u12463 \u12399 \u12354 \u12426 \u12414 \u12379 \u12435 </p>`;\
      \} else \{\
        delayedContainer.innerHTML = delayedTasks.map(t => `\
          <div onclick="scrollToTask('$\{t.idKey\}')" class="p-2 bg-red-50 hover:bg-red-100 border border-red-200 rounded cursor-pointer transition flex justify-between items-center">\
            <div>\
              <span class="font-bold text-red-700">$\{t.id\} $\{escapeHTML(t.name)\}</span>\
              <p class="text-[10px] text-red-500">\uc0\u26399 \u38480 : $\{t.end\} ($\{t.assignee\})</p>\
            </div>\
            <i class="fa-solid fa-arrow-right-to-bracket text-red-400"></i>\
          </div>\
        `).join("");\
      \}\
\
      // 4. \uc0\u20445 \u30041 \u12479 \u12473 \u12463 \u19968 \u35239 \u34920 \u31034 \
      const pendingTasks = tasksData.filter(t => t.status === "\uc0\u20445 \u30041 \u20013 ");\
      const pendingContainer = document.getElementById("pending-tasks-list");\
      if (pendingTasks.length === 0) \{\
        pendingContainer.innerHTML = `<p class="text-slate-400 italic">\uc0\u20445 \u30041 \u20013 \u12398 \u12479 \u12473 \u12463 \u12399 \u12354 \u12426 \u12414 \u12379 \u12435 </p>`;\
      \} else \{\
        pendingContainer.innerHTML = pendingTasks.map(t => `\
          <li class="py-1 flex justify-between items-center">\
            <span class="font-medium">$\{t.id\} $\{escapeHTML(t.name)\}</span>\
            <span class="text-slate-400 text-[10px]">$\{t.assignee\}</span>\
          </li>\
        `).join("");\
      \}\
\
      // 5. \uc0\u20250 \u31038 \u21029 \u12479 \u12473 \u12463 \u36000 \u33655 \u12464 \u12521 \u12501  (Chart.js)\
      updateCompanyChart();\
    \}\
\
    function initCompanyChart() \{\
      const ctx = document.getElementById("companyChart").getContext("2d");\
      companyChartInstance = new Chart(ctx, \{\
        type: "doughnut",\
        data: \{\
          labels: [],\
          datasets: [\{\
            data: [],\
            backgroundColor: ["#3b82f6", "#10b981", "#f59e0b", "#8b5cf6"]\
          \}]\
        \},\
        options: \{\
          responsive: true,\
          maintainAspectRatio: false,\
          plugins: \{\
            legend: \{ position: "bottom", labels: \{ boxWidth: 12, font: \{ size: 10 \} \} \}\
          \}\
        \}\
      \});\
    \}\
\
    function updateCompanyChart() \{\
      if (!companyChartInstance) return;\
      const companyCounts = \{\};\
      tasksData.forEach(t => \{\
        companyCounts[t.assignee] = (companyCounts[t.assignee] || 0) + 1;\
      \});\
\
      companyChartInstance.data.labels = Object.keys(companyCounts);\
      companyChartInstance.data.datasets[0].data = Object.values(companyCounts);\
      companyChartInstance.update();\
    \}\
\
    // \uc0\u36933 \u24310 \u12479 \u12473 \u12463 \u12408 \u12398 \u12473 \u12512 \u12540 \u12473 \u12473 \u12463 \u12525 \u12540 \u12523 \u31227 \u21205 \
    function scrollToTask(idKey) \{\
      const row = document.getElementById(`task-row-$\{idKey\}`);\
      if (row) \{\
        row.scrollIntoView(\{ behavior: "smooth", block: "center" \});\
        row.classList.add("bg-amber-100");\
        setTimeout(() => row.classList.remove("bg-amber-100"), 2000);\
      \}\
    \}\
\
    /* -------------------------------------------------------------\
     * 6. \uc0\u12514 \u12540 \u12480 \u12523  & \u12479 \u12473 \u12463  CRUD \u25805 \u20316 \
     * ------------------------------------------------------------- */\
    function openAddTaskModal() \{\
      document.getElementById("modal-title").innerText = "\uc0\u12479 \u12473 \u12463 \u26032 \u35215 \u36861 \u21152 ";\
      document.getElementById("task-form").reset();\
      document.getElementById("task-id-key").value = "";\
      document.getElementById("task-modal").classList.remove("hidden");\
    \}\
\
    function openEditTaskModal(idKey) \{\
      const task = tasksData.find(t => t.idKey === idKey);\
      if (!task) return;\
\
      document.getElementById("modal-title").innerText = "\uc0\u12479 \u12473 \u12463 \u32232 \u38598 ";\
      document.getElementById("task-id-key").value = task.idKey;\
      document.getElementById("task-id").value = task.id;\
      document.getElementById("task-cat").value = task.cat;\
      document.getElementById("task-name").value = task.name;\
      document.getElementById("task-assignee").value = task.assignee;\
      document.getElementById("task-start").value = task.start;\
      document.getElementById("task-end").value = task.end;\
      document.getElementById("task-status").value = task.status;\
      document.getElementById("task-cp").checked = task.cp;\
\
      document.getElementById("task-modal").classList.remove("hidden");\
    \}\
\
    function closeTaskModal() \{\
      document.getElementById("task-modal").classList.add("hidden");\
    \}\
\
    function handleTaskSubmit(e) \{\
      e.preventDefault();\
      const idKey = document.getElementById("task-id-key").value || "t_" + Date.now();\
      \
      const newTask = \{\
        idKey: idKey,\
        id: document.getElementById("task-id").value,\
        cat: parseInt(document.getElementById("task-cat").value),\
        name: document.getElementById("task-name").value,\
        assignee: document.getElementById("task-assignee").value,\
        start: document.getElementById("task-start").value,\
        end: document.getElementById("task-end").value,\
        status: document.getElementById("task-status").value,\
        cp: document.getElementById("task-cp").checked\
      \};\
\
      const existingIndex = tasksData.findIndex(t => t.idKey === idKey);\
      if (existingIndex >= 0) \{\
        tasksData[existingIndex] = newTask;\
      \} else \{\
        tasksData.push(newTask);\
      \}\
\
      saveTasksData();\
      closeTaskModal();\
    \}\
