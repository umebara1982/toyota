     * ------------------------------------------------------------- */\
    window.addEventListener("DOMContentLoaded", () => \{\
      initCompanyChart();\
      \
      if (isFirebaseConnected && dbRef) \{\
        // Firebase \uc0\u12522 \u12450 \u12523 \u12479 \u12452 \u12512 \u21516 \u26399 \u30435 \u35222 \
        document.getElementById("sync-text").innerText = "Firebase \uc0\u36899 \u25658 \u20013 ";\
        document.getElementById("sync-dot").className = "w-2 h-2 rounded-full bg-emerald-500 animate-ping";\
\
        dbRef.on("value", (snapshot) => \{\
          const val = snapshot.val();\
          if (val) \{\
            tasksData = Array.isArray(val) ? val : Object.values(val);\
          \} else \{\
            // \uc0\u21021 \u22238 \u12487 \u12540 \u12479 \u26410 \u30331 \u37682 \u12398 \u22580 \u21512 \u12289 \u21021 \u26399 \u12487 \u12540 \u12479 \u25237 \u20837 \
            tasksData = INITIAL_TASKS;\
            dbRef.set(tasksData);\
          \}\
          refreshUI();\
        \});\
      \} else \{\
        // \uc0\u12525 \u12540 \u12459 \u12523 \u12473 \u12488 \u12524 \u12540 \u12472 \u36939 \u29992 \u12501 \u12457 \u12540 \u12523 \u12496 \u12483 \u12463 \
        document.getElementById("sync-text").innerText = "\uc0\u12525 \u12540 \u12459 \u12523 \u21205 \u20316 \u20013 ";\
